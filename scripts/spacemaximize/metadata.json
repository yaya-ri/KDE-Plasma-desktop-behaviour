{
    "KPackageStructure": "KWin/Script",
    "KPlugin": {
        "Authors": [
            {
                "Name": "yaya-ri"
            }
        ],
        "Category": "Window Management",
        "Description": "Maximize or fullscreen a window into its own new virtual desktop with a slide animation, like macOS Spaces. Restoring the window slides back and removes the desktop.",
        "EnabledByDefault": false,
        "Icon": "preferences-desktop-virtual",
        "Id": "spacemaximize",
        "License": "GPL",
        "Name": "Maximize to New Desktop",
        "Version": "1.0",
        "Website": "https://github.com/yaya-ri/KDE-Plasma-desktop-behaviour"
    },
    "X-KDE-ConfigModule": "kcm_kwin4_genericscripted",
    "X-Plasma-API": "javascript"
}
